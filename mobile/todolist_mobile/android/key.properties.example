# 签名密钥配置示例文件
# 复制此文件为 key.properties 并填入你的实际密钥信息
# 
# 注意：key.properties 文件已添加到 .gitignore，不会被提交到版本控制
#
# 如何生成密钥，请参考 GOOGLE_PLAY_RELEASE.md 文档

# 密钥库文件路径（相对于 android 目录）
storeFile=upload-keystore.jks

# 密钥库密码
storePassword=your_keystore_password

# 密钥别名
keyAlias=upload

# 密钥密码
keyPassword=your_key_password
