# 环境配置示例文件
# 复制此文件为 .env 并填入实际的配置值

# 应用环境: development 或 production
ENVIRONMENT=development

# 开发环境API地址
DEV_API_URL=http://localhost:8080/api/v1

# 生产环境API地址
PROD_API_URL=http://localhost:8080/api/v1

# WebSocket地址（可选）
# DEV_WS_URL=ws://localhost:8080/ws
# PROD_WS_URL=wss://api.todolist.com/ws

# 应用配置
APP_NAME=ToDoList
APP_VERSION=0.1.2

# 功能开关（可选）
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_DEBUG_MODE=true

# API超时设置（毫秒）
API_TIMEOUT=30000

# 本地存储配置
MAX_CACHE_SIZE=50
AUTO_SYNC_INTERVAL=300
