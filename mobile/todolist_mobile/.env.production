# 生产环境配置文件
# 使用方法：复制为 .env 以使用生产环境配置

# 应用环境
ENVIRONMENT=production

# 开发环境API地址
DEV_API_URL=https://api-todo.gui.ink/api/v1

# 生产环境API地址（请修改为实际的生产环境地址）
PROD_API_URL=https://api-todo.anixops.com/api/v1

# WebSocket地址
# DEV_WS_URL=ws://localhost:8080/ws
# PROD_WS_URL=wss://api.todolist.com/ws

# 应用配置
APP_NAME=ToDoList
APP_VERSION=0.1.2

# 功能开关
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true
ENABLE_DEBUG_MODE=false

# API超时设置（毫秒）
API_TIMEOUT=30000

# 本地存储配置
MAX_CACHE_SIZE=100
AUTO_SYNC_INTERVAL=180
